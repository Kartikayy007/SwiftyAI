# The pkg-config and .build directories are used by the Swift Package Manager.
.build/
.swiftpm/
Packages/
Package.resolved

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# if you wish to do so, uncomment the line below.
# Pods/

# Carthage
#
# Add this line if you want to ignore Carthage artifacts
# Carthage/Build/

# fastlane
#
# It is recommended to not store the screenshots in the repo since they will
# occupy large amount of storage and represent an un-mergeable binary diff.
# fastlane/screenshots
# fastlane/test_output

# Tooling
# Uncomment the line below if you don't want to push AI instruction files
# CLAUDE.md
.claudesettings

